rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // É administrador quem tem um documento com o próprio UID na coleção "admins".
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Lista de sistemas: qualquer pessoa lê, só o administrador grava.
    match /sistemas/{id} {
      allow read: if true;
      allow create, update: if isAdmin()
        && request.resource.data.nome is string
        && request.resource.data.nome.size() > 0
        && request.resource.data.links is list
        && request.resource.data.links.size() > 0;
      allow delete: if isAdmin();
    }

    // Cada usuário só consegue consultar o próprio registro de admin.
    // Ninguém grava por aqui: o cadastro é feito no console do Firebase.
    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }
  }
}
